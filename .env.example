# ═══════════════════════════════════════════
# BL RCA AGENT — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════

# ── LLM Gateway (Intermesh Internal) ───────
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=

# ── Parallel AI ─────────────────────────────
PARALLEL_API_KEY=

# ── Anthropic (Orchestrator tool calling) ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# ── Langfuse (Observability) ────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Model Defaults ───────────────────────────
GEMINI_FLASH=gemini-1.5-flash
DEFAULT_EXTRACTION_MODEL=gemini-1.5-flash
DEFAULT_PARALLEL_PROCESSOR=base-fast

# ── App Config ───────────────────────────────
LOG_LLM_CALLS=true
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_DELAY=2
RCA_CONFIDENCE_THRESHOLD=60

# ── Redash (data source — replaces CSVs) ─────
REDASH_URL=https://redash.intermesh.net
REDASH_API_KEY=
REDASH_POLL_INTERVAL=1.5
REDASH_QUERY_TIMEOUT=180
# Data-source IDs on this Redash instance
REDASH_DS_BL=16
REDASH_DS_BUYER=16
REDASH_DS_SELLER=16
REDASH_DS_MCATSPEC=8

# ── DWH (direct Redshift) ──────────────────
DWH_HOST=
DWH_PORT=5439
DWH_DB=
DWH_USER=
DWH_PASSWORD=
DWH_SSLMODE=require
